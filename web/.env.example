# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# Alpaca — fuente ALTERNATIVA de la capa de agresividad (ask/bid + griegos).
# Si estas dos están presentes, la ruta de flujo usa Alpaca en vez de MarketSnack.
# Saca las claves en https://app.alpaca.markets (API Keys). El plan gratis sirve.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
